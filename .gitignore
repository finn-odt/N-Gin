# ------------------------------------------------------------
# Visual Studio user-specific files
# ------------------------------------------------------------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb

# ------------------------------------------------------------
# Visual Studio build output
# ------------------------------------------------------------
Debug/
Release/
x64/
x86/

[Bb]in/
[Oo]bj/

# In case configuration folders exist inside project folders
**/Debug/
**/Release/
**/x64/Debug/
**/x64/Release/
**/x86/Debug/
**/x86/Release/

# ------------------------------------------------------------
# C / C++ compiled files
# ------------------------------------------------------------
*.obj
*.o
*.lo
*.slo

# Precompiled headers
*.pch
*.gch

# ------------------------------------------------------------
# Linker / compiler output
# ------------------------------------------------------------
*.ilk
*.exp
*.iobj
*.ipdb

# Libraries
*.lib
*.a
*.la
*.lai

# Dynamic libraries
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# ------------------------------------------------------------
# Debug symbols / diagnostics
# ------------------------------------------------------------
*.pdb
*.idb
*.dwo

# Crash dumps
*.dmp
*.mdmp

# ------------------------------------------------------------
# Incremental / intermediate Visual Studio files
# ------------------------------------------------------------
*.tlog
*.lastbuildstate
*.recipe
*.log
*.tmp

# Generated compiler files
*.ipch
*.aps

# Browse / IntelliSense databases
*.sdf
*.opensdf
*.ncb

# ------------------------------------------------------------
# CMake
# Keep this even if you currently use .vcxproj files.
# It prevents junk if someone experiments with CMake later.
# ------------------------------------------------------------
build/
Build/
build-*/

CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# ------------------------------------------------------------
# vcpkg
# ------------------------------------------------------------
vcpkg_installed/

# Keep manifests if you add them later:
# vcpkg.json
# vcpkg-configuration.json

# ------------------------------------------------------------
# Testing / profiling / cache
# ------------------------------------------------------------
Testing/
.cache/

# Visual Studio profiling
*.psess
*.vsp
*.vspx
*.sap

# ------------------------------------------------------------
# Temporary / backup files
# ------------------------------------------------------------
*.bak
*.tmp
*.temp
*.swp
*.swo
*~
~$*

# ------------------------------------------------------------
# OS-generated files
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

